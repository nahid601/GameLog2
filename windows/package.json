{
  "name": "game-log",
  "version": "1.0.0",
  "description": "Track the games you have played and want to play",
  "author": "Game Log",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gamelog.app",
    "productName": "Game Log",
    "files": ["main.js", "index.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
